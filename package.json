{
  "name": "obsidian-plugin-dev-kit",
  "version": "0.3.0",
  "description": "Build, lint, release, test and film Obsidian plugins from one shared dev dependency.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dmitriy Yurkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimagious/obsidian-plugin-dev-kit.git"
  },
  "bin": {
    "opdk": "./bin/opdk.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./vitest/dom": {
      "types": "./dist/vitest/dom/index.d.ts",
      "default": "./dist/vitest/dom/index.js"
    },
    "./vitest/dom/setup": {
      "types": "./dist/vitest/dom/setup.d.ts",
      "default": "./dist/vitest/dom/setup.js"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "files": [
    "bin",
    "dist",
    "docs/*.md",
    "plugins/opdk/skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "smoke": "bash scripts/pack-smoke.sh",
    "plugin:validate": "node scripts/plugin-validate.mjs",
    "e2e:smoke": "playwright test -c test/e2e-fixture/playwright.config.ts",
    "prepare": "npm run build",
    "docs:media": "vhs docs/media/build.tape && vhs docs/media/build-check-fails.tape && vhs docs/media/scan.tape && vhs docs/media/scan-fails.tape",
    "docs:media:e2e": "bash scripts/docs-media-e2e.sh",
    "docs:media:demo": "bash scripts/docs-media-demo.sh"
  },
  "dependencies": {
    "doiuse": "6.0.6",
    "esbuild": "0.28.2",
    "eslint-plugin-obsidianmd": "0.5.1",
    "postcss": "8.5.32",
    "typescript-eslint": "8.72.2"
  },
  "peerDependencies": {
    "eslint": "^9.19.0 || ^10.0.0",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.3",
    "eslint": "10.14.0",
    "jsdom": "30.1.1",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}

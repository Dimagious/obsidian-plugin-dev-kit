{
  "name": "obsidian-plugin-dev-kit",
  "version": "0.0.0",
  "description": "Build, lint, release, test and film Obsidian plugins from one shared dev dependency.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dmitriy Yurkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimagious/obsidian-plugin-dev-kit.git"
  },
  "bin": {
    "opdk": "./bin/opdk.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "smoke": "bash scripts/pack-smoke.sh",
    "prepare": "npm run build",
    "docs:media": "vhs docs/media/build.tape && vhs docs/media/build-check-fails.tape"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
